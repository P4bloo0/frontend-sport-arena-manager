# Plantilla de variables de entorno.
# Copiar como .env (no se versiona) y ajustar los valores.
#
# En EP1 y EP2 no se utiliza: los datos son simulados en js/datos.js.
# En EP3 el frontend lee estas variables para consumir el API Gateway.

# URL base del API Gateway de eSports Arena Manager
API_BASE_URL=http://localhost:8080

# Ruta del servicio de autenticacion que emite el token JWT
API_AUTH_PATH=/auth
